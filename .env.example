# BHUMI-INTEL Environment Configuration

# Project Settings
PROJECT_NAME="BHUMI-INTEL"
PROJECT_VERSION="1.0.0"
DEMO_MODE=true

# Security
SECRET_KEY="bhumi-intel-secure-jwt-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default local SQLite fallback, switch to PostgreSQL in docker/production)
DATABASE_URL="sqlite:///./bhumi_intel.db"
# DATABASE_URL="postgresql://bhumi_user:bhumi_password@localhost:5432/bhumi_db"

# Search Architecture
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL="http://localhost:9200"

# GIS Architecture
GEOSERVER_ENABLED=false
GEOSERVER_URL="http://localhost:8080/geoserver"

# LLM Providers (Options: "fallback", "gemini", "openai")
LLM_PROVIDER="fallback"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
